+from subjectAlignedModels.SANN_eye import SANN_eye, weight_init
+from source_select import Source_Select
+
+import copy
+import sys
+import torch.optim as optim
+import torch.utils.data
+from mydata_loader import Mydataset
+import numpy as np
+
+# Protocol-adapted CSMM. Every change from upstream commit ea99eed is
+# marked "protocol adaptation" or "compatibility fix" and listed in deviations.md. This file is
+# driven by ccsi/comparators.py; its released __main__ (SEED-IV .mat loading, target evaluation,
+# metric export) is removed.
+#
+# Released settings kept exactly (read from the executable code): Adam lr 0.002, weight decay
+# 1e-3, source/target batch 64/64, NLLLoss for class and domain, the alpha schedule, and
+# N_EPOCH = 2000 for this eye stage (as released).
+N_EPOCH = 2000
+STAGE = "eye_sann"
+
+
+def make_model():
+    model = SANN_eye()
+    model.apply(weight_init)
+    return model
+
+
+class TailMergingBatchSampler(torch.utils.data.Sampler):
+    """Compatibility fix: explicit handling of singleton batches. One shuffled pass per
+    iteration (seeded generator); consecutive batches of `batch_size`; a final batch of size 1
+    (which BatchNorm1d cannot train on) is merged into the previous batch. No window is dropped.
+    Replaces DataLoader(shuffle=True), which could yield a size-1 final batch."""
+
+    def __init__(self, n, batch_size, generator):
+        self.n, self.batch_size, self.generator = n, batch_size, generator
+
+    def __iter__(self):
+        perm = torch.randperm(self.n, generator=self.generator).tolist()
+        out = [perm[i:i + self.batch_size] for i in range(0, self.n, self.batch_size)]
+        if len(out) > 1 and len(out[-1]) < 2:
+            out[-2] = out[-2] + out[-1]
+            out = out[:-1]
+        return iter(out)
+
+    def __len__(self):
+        k = -(-self.n // self.batch_size)
+        return k - 1 if k > 1 and self.n % self.batch_size == 1 else k
+
+
+@torch.no_grad()
+def predict_logprob(model, data, device, chunk=8192):
+    """Protocol adaptation: label-free prediction (replaces the released evaluate(model, data,
+    label), which read labels and enabled cudnn.benchmark). Eval mode on a deep copy, so the
+    training model's state and RNG are untouched. Returns window log-softmax scores (numpy)."""
+    net = copy.deepcopy(model).to(device).eval()
+    out = []
+    for i in range(0, len(data), chunk):
+        class_output, _ = net(input_data=data[i:i + chunk].float().to(device), alpha=0)
+        out.append(class_output.cpu().numpy())
+    return np.concatenate(out)
+
+
+def train_and_evaluate(model, source_domains, target_data, val_eval, device, generator, n_epoch=N_EPOCH):
+    """Protocol adaptation of the released train_and_evaluate(model, subjectIndex, source_data,
+    source_label, target_data, target_label, domain_size).
+
+    source_domains: list of (subject_id, X float tensor, y long tensor), one per source TRAINING
+        subject (validation subjects excluded by the caller);
+    target_data: float tensor of ALL target windows, no labels;
+    val_eval: callable(model) -> source-validation TRIAL accuracy (eval mode, no state change);
+    Checkpoint = best source-validation trial accuracy over epochs (strict >, first maximum),
+    replacing the released selection by TARGET accuracy. Returns (best_state_dict, info).
+    """
+    lr = 0.002
+    batch_size = 64
+    batch_size_t = 64
+    loss_class = torch.nn.NLLLoss()
+    loss_domain = torch.nn.NLLLoss()
+
+    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=1e-3)
+    for p in model.parameters():
+        p.requires_grad = True
+    # training
+    model = model.to(device)
+    best_val, best_state, best_epoch = -1.0, None, 0
+    curve, selections = [], []
+    for epoch in range(n_epoch):
+        # protocol adaptation: explicit subject domains, list reset every epoch; one remaining
+        # subject is selected and removed at a time (replaces equal-block slicing/np.delete)
+        remaining = list(source_domains)
+        sum_cls, sum_dom, n_steps = 0.0, 0.0, 0
+        while remaining:
+            # select domain
+            sel_source_id, scores = Source_Select(model, [d[1] for d in remaining], target_data)
+            selections.append({"epoch": epoch + 1, "candidates": [int(d[0]) for d in remaining],
+                               "scores": scores, "selected": int(remaining[sel_source_id][0])})
+            _, Sour_data, Sour_label = remaining[sel_source_id]
+            # make dataset
+            source_dataset = Mydataset(Sour_data, Sour_label)
+            dataloader_source = torch.utils.data.DataLoader(
+                dataset=source_dataset,
+                batch_sampler=TailMergingBatchSampler(len(source_dataset), batch_size, generator))
+            target_dataset = Mydataset(target_data)  # protocol adaptation: no target labels
+            dataloader_target = torch.utils.data.DataLoader(
+                dataset=target_dataset,
+                batch_sampler=TailMergingBatchSampler(len(target_dataset), batch_size_t, generator))
+            len_dataloader = min(len(dataloader_source), len(dataloader_target))
+            data_source_iter = iter(dataloader_source)
+            data_target_iter = iter(dataloader_target)
+
+            for i in range(len_dataloader):
+                p = float(i + epoch * len_dataloader) / n_epoch / len_dataloader
+                alpha = 2. / (1. + np.exp(-10 * p)) - 1
+                s_data, s_label = next(data_source_iter)  # compatibility fix: .next() -> next()
+                s_data = s_data.float()
+                s_label = s_label.long()
+                batch_size = len(s_label)
+                domain_label_s = torch.zeros(batch_size).long()
+                model.zero_grad()
+                s_data = s_data.to(device)
+                s_label = s_label.to(device)
+                class_output, _ = model(input_data=s_data, alpha=alpha)
+                err_s_label = loss_class(class_output, s_label)
+
+                # training model using target and source data
+                t_data = next(data_target_iter)  # compatibility fix; protocol adaptation: no label unpacked
+                t_data = t_data.float()
+                t_data = t_data.to(device)
+                batch_size = len(t_data)
+                domain_label_t = torch.ones(batch_size).long()
+                data_s_t = torch.cat([s_data, t_data], dim=0)
+                label_s_t = torch.cat([domain_label_s, domain_label_t], dim=0)
+                num_sample = data_s_t.shape[0]
+                index = np.random.choice(np.arange(num_sample), size=num_sample, replace=False)
+                data_s_t = data_s_t[index]
+                label_s_t = label_s_t[index]
+                data_s_t = data_s_t.to(device)
+                label_s_t = label_s_t.to(device)
+                _, domain_output = model(input_data=data_s_t, alpha=alpha)
+                err_domain = loss_domain(domain_output, label_s_t)
+                err = err_domain + err_s_label
+                err.backward()
+                optimizer.step()
+                sum_cls += float(err_s_label.item()); sum_dom += float(err_domain.item()); n_steps += 1
+            remaining.pop(sel_source_id)
+        # protocol adaptation: per-epoch SOURCE-VALIDATION trial accuracy replaces the released
+        # target evaluate()/cal_metrics; accu_s (source-TRAINING window accuracy, as released) is
+        # recorded for the training curve only, never used for selection.
+        src_x = torch.cat([d[1] for d in source_domains]); src_y = torch.cat([d[2] for d in source_domains])
+        accu_s = float((predict_logprob(model, src_x, device).argmax(1) == src_y.numpy()).mean())
+        val_acc = val_eval(model)
+        curve.append({"epoch": epoch + 1, "train_class_nll": sum_cls / max(n_steps, 1),
+                      "train_domain_nll": sum_dom / max(n_steps, 1), "steps": n_steps,
+                      "accu_s_source_train_window": accu_s, "val_trial_acc": val_acc})
+        sys.stdout.write(f'\r[{STAGE}] epoch {epoch + 1}/{n_epoch} steps {n_steps} accu_s {accu_s:.4f} val {val_acc:.4f}')
+        sys.stdout.flush()
+        if val_acc > best_val:
+            best_val, best_epoch = val_acc, epoch + 1
+            best_state = copy.deepcopy(model.state_dict())
+    sys.stdout.write('\n')
+    return best_state, {"source_val_acc": best_val, "selected_epoch": best_epoch, "curve": curve,
+                        "selections": selections, "total_updates": sum(c["steps"] for c in curve)}
+
+
+if __name__ == '__main__':
+    raise SystemExit("protocol-adapted CSMM: run through scripts/07_comparators.py (ccsi/comparators.py)")
