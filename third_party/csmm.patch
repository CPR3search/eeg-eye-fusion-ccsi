+from sklearn import preprocessing
+
+# Protocol-adapted CSMM fusion stage. Every change from upstream commit
+# ea99eed is marked "protocol adaptation" or "compatibility fix" and listed in deviations.md.
+# Driven by ccsi/comparators.py; the released __main__ (SEED-IV .mat loading, target metrics and
+# Excel export) is removed.
+#
+# Compatibility fix: the configuration is frozen here instead of being read with ruamel.yaml
+# (not installed). Values are configs/eeg_eye.yaml's, except where the executable code overrides
+# them (batch 128 with drop_last in the DataLoader below, not batch_size_train 256; the YAML's
+# cosine scheduler is never built or stepped by the released main loop and stays off).
+# tests/test_csmm.py checks these values against configs/eeg_eye.yaml.
+CONFIG = {"batch_size_train": 256, "batch_size_test": 256, "queue_size": 4096, "momentum": 0.90,
+          "eeg_dim": 128, "eye_dim": 256, "embed_dim": 64, "temp": 0.5, "k_test": 128, "alpha": 0.7,
+          "warm_up": True, "optimizer": {"opt": "adamw", "lr": 0.00001, "weight_decay": 1e-3}}
+FUSION_EPOCHS = 200
+FUSION_BATCH = 128
+STAGE = "fusion"
