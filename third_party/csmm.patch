+import numpy as np
+import torch
+import torch.nn.functional as F
+
+
+def Source_Select(model, Source_domains, Target_data):
+    """Protocol adaptation: explicit subject domains.
+
+    Released: Source_Select(model, Source_data, Target_data, domain_size) cut the (globally
+    shuffled) source rows into equal blocks of `domain_size` and scored block i. Now
+    `Source_domains` is a list of float tensors, one per remaining source TRAINING subject (all of
+    that subject's windows, any count); the caller removes the chosen subject from its list.
+
+    Unchanged from the release (frozen):
+      - score of candidate i: mean NLL of the domain classifier over the concatenation of that
+        subject's windows (domain label 0) and ALL target windows (domain label 1), after one
+        np.random.choice shuffle (global NumPy RNG, seeded by the caller); with unequal source
+        and target counts every window counts once in this mean (the released equal-block data
+        fixed both counts to domain_size; that weighting is not re-imposed);
+      - forward pass with alpha=0 in whatever mode the model is in (train mode during SANN
+        training, as released: dropout active, BatchNorm uses batch statistics and updates its
+        running statistics);
+      - selection direction: minimise the NEGATIVE domain NLL, i.e. pick the candidate with the
+        LARGEST domain NLL; candidates in list order; ties keep the earlier candidate (strict <).
+    Compatibility fix: device taken from the model (released hard-coded "cuda").
+    Uses binary DOMAIN labels only; no emotion label is read.
+    Returns (selected index into Source_domains, list of the negative-NLL scores).
+    """
+    min_neg_loss_domain = 0.0
+    min_Source_id = -1
+    device = next(model.parameters()).device
+    loss_domain = torch.nn.NLLLoss()
+    scores = []
+    for i in range(len(Source_domains)):
+        source = Source_domains[i].float()
+        target = Target_data.float()
+        size_s = len(source)
+        size_t = len(target)
+        domain_label_source = torch.zeros(size_s)
+        domain_label_target = torch.ones(size_t)
+
+        data_source_target = torch.cat([source, target], dim=0)
+        label_source_target = torch.cat([domain_label_source, domain_label_target], dim=0)
+        num_s_t = data_source_target.shape[0]
+        index = np.random.choice(np.arange(num_s_t), size=num_s_t, replace=False)
+        data_source_target = data_source_target[index]
+        label_source_target = label_source_target[index]
+        data_source_target = data_source_target.to(device)
+        label_source_target = label_source_target.to(device)
+        label_source_target = label_source_target.long()
+
+        _, domain_output = model(input_data=data_source_target, alpha=0)
+        err_domain = loss_domain(domain_output, label_source_target)
+        err_domain = -err_domain
+        scores.append(float(err_domain.item()))
+
+        if (i == 0):
+            min_Source_id = i
+            min_neg_loss_domain = err_domain
+        else:
+            if err_domain < min_neg_loss_domain:
+                min_Source_id = i
+                min_neg_loss_domain = err_domain
+
+    return min_Source_id, scores
