+class Dataset_seed(Dataset):
+    def __init__(self, data):
+        self.datas = data
+
+    def __getitem__(self, index):
+        return self.datas[index]
+
+    def __len__(self):
+        return len(self.datas)
+
+
+def setup_seed(seed):  # released helper, not called by the released entry point (kept, unused)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+    np.random.seed(seed)
+    random.seed(seed)
+    torch.backends.cudnn.deterministic = True
+
+
+@torch.no_grad()
+def aligned_features(net, x, device, chunk=8192):
+    """Released feature path (shallow s_fc1 -> s_bn1 -> s_relu1 -> s_drop1 -> s_fc2) of a SANN
+    in eval mode, as float64 numpy. Compatibility fix: computed on `device` in chunks (released:
+    on CPU in one pass); eval mode makes it per-window, so chunking does not change values."""
+    net = net.eval()
+    out = []
+    for i in range(0, len(x), chunk):
+        xb = x[i:i + chunk].float().to(device)
+        feature = net.shallow.s_bn1(net.shallow.s_fc1(xb))
+        feature = net.shallow.s_drop1(net.shallow.s_relu1(feature))
+        feature = net.shallow.s_fc2(feature)
+        out.append(feature.cpu().numpy().astype(np.float64))
+    return np.concatenate(out)
+
+
+def preprocess_dataset(S_eeg_trans, S_eye_trans, S_label, S_idx, T_eeg_trans, T_eye_trans):
+    """Protocol adaptation of the released preprocess_dataset(DATA):
+      - no target labels (the released version read DATA['T_label'] into Test_datas);
+      - MinMax(-1, 1) scalers fit, as released, on source + target aligned features -- here the
+        source TRAINING subjects' windows plus the unlabelled target windows only (validation
+        subjects are excluded); the caller applies the frozen scalers to validation windows;
+      - example['idx'] is our source trial-instance id (1-based; the EEG and eye windows of one
+        trial share it), replacing the hard-coded SEED-IV session-1 `trail_boundary` lookup.
+        These ids define the contrastive positives (contrastiveModel_IV.py lines 63-67). Ids
+        start at 1 because the released idx_queue is initialised with 0 (released ids also
+        started at 1), so initial queue entries never count as positives.
+    Returns Train_datas, scaler_eeg, scaler_eye."""
+    Train_datas = []
+    train1, train2, test1, test2 = S_eeg_trans, S_eye_trans, T_eeg_trans, T_eye_trans
+
+    min_max_scaler1 = preprocessing.MinMaxScaler(feature_range=(-1, 1))
+    data1 = np.concatenate((train1, test1), axis=0)
+    scaler_eeg = min_max_scaler1.fit(data1)
+    train_data_eeg = scaler_eeg.transform(train1)
+    min_max_scaler2 = preprocessing.MinMaxScaler(feature_range=(-1, 1))
+    data2 = np.concatenate((train2, test2), axis=0)
+    scaler_eye = min_max_scaler2.fit(data2)
+    train_data_eye = scaler_eye.transform(train2)
+
+    assert int(np.min(S_idx)) >= 1
+    for i in range(train_data_eeg.shape[0]):
+        example = {}
+        example_x = torch.from_numpy(train_data_eeg[i, :])
+        example_x = example_x.float()
+        example_x = torch.unsqueeze(example_x, 1)
+
+        example_y = torch.from_numpy(train_data_eye[i, :])
+        example_y = example_y.float()
+        example_y = torch.unsqueeze(example_y, 1)
+
+        example['eeg'] = example_x
+        example['eye'] = example_y
+        example['idx'] = int(S_idx[i])
+        example['label'] = int(S_label[i])
+        Train_datas.append(example)
+
+    return Train_datas, scaler_eeg, scaler_eye
+
+
+def Train(model, data_loader, optimizer, epoch, device, config):
+    model.train()
+    running_correct = 0.0
+    sums = {"contrast": 0.0, "match": 0.0, "class": 0.0, "n": 0}
+    for i, data in enumerate(data_loader):
+        eeg = data['eeg']
+        eye = data['eye']
+        idx = data['idx']
+        labels = data['label']
+        eeg = eeg.to(device, non_blocking=True)
+        eye = eye.to(device, non_blocking=True)
+        idx = idx.to(device, non_blocking=True)
+        labels = labels.to(device, non_blocking=True)
+        if epoch > 0 or not config['warm_up']:
+            alpha = config['alpha']
+        else:
+            alpha = config['alpha'] * min(1, i / len(data_loader))
+
+        loss_contrast, loss_match, loss_class, pred = model(eeg, eye, alpha=alpha, idx=idx, labels=labels)
+        _, pred_labels = torch.max(pred, 1)
+        pred_labels = pred_labels.to(device, non_blocking=True)
+        running_correct += torch.sum(pred_labels == labels)
+        loss = loss_contrast * 0.9 + loss_match + loss_class
+        sys.stdout.flush()
+        optimizer.zero_grad()
+        loss.backward()
+        optimizer.step()
+        sums["contrast"] += float(loss_contrast.item()); sums["match"] += float(loss_match.item())
+        sums["class"] += float(loss_class.item()); sums["n"] += 1
+    return running_correct, sums
+
+
+@torch.no_grad()
+def Predict(model, eeg_data, eye_data, device, eeg_model, eye_model, scale_eeg, scale_eye, chunk=8192):
+    """Protocol adaptation of the released Test(model, TESTDATA, ...): label-free. Returns the
+    window-level component scores the released code computed -- fusion log-softmax (`predict`),
+    EEG SANN log-softmax (`eeg_output`), eye SANN log-softmax (`eye_output`) -- and the released
+    combined score All_predict = L1-normalised(fusion) + L1-normalised(eeg) + L1-normalised(eye)
+    (released lines 181-187). Runs on a deep copy in eval mode: no state change."""
+    net = copy.deepcopy(model).eval()
+    comps = {"fusion": [], "eeg": [], "eye": [], "all": []}
+    for i in range(0, len(eeg_data), chunk):
+        e, y = eeg_data[i:i + chunk].float().to(device), eye_data[i:i + chunk].float().to(device)
+        T_eeg_aligned = torch.from_numpy(scale_eeg.transform(aligned_features(eeg_model, e, device))).float().to(device)
+        T_eye_aligned = torch.from_numpy(scale_eye.transform(aligned_features(eye_model, y, device))).float().to(device)
+        predict, _ = net.model_testforward(T_eeg_aligned, T_eye_aligned)
+        eeg_output, _ = eeg_model.eval()(input_data=e, alpha=0)
+        eye_output = eye_model.eval().shallow(y)
+        eye_output = eye_model.deep(eye_output)
+        eye_output = eye_model.class_classifier(eye_output)
+        All_predict = F.normalize(predict, p=1, dim=1) + F.normalize(eeg_output, p=1, dim=1) + F.normalize(eye_output, p=1, dim=1)
+        for k, v in (("fusion", predict), ("eeg", eeg_output), ("eye", eye_output), ("all", All_predict)):
+            comps[k].append(v.cpu().numpy())
+    return {k: np.concatenate(v) for k, v in comps.items()}
+
+
+def combined_window_probs(comps):
+    """Protocol adaptation (trial-probability output rule): softmax at temperature 1 of the released
+    combined score; trial probabilities are then the mean of these window probabilities."""
+    a = comps["all"]
+    a = a - a.max(1, keepdims=True)
+    e = np.exp(a)
+    return e / e.sum(1, keepdims=True)
+
+
+def main_seed(config, net_eeg, net_eye, S_eeg, S_eye, S_label, S_idx, T_eeg, T_eye, val_eval, device, generator,
+              n_epochs=FUSION_EPOCHS):
+    """Protocol adaptation of the released main_seed(args, config, file_dir, eeg_model_name,
+    eye_model_name, subjectIndex): inputs are tensors from our pipeline (source TRAINING windows
+    with labels and trial ids; target windows WITHOUT labels); the two SANN parents are passed in
+    (already at their selected checkpoints, eval mode). Checkpoint = best source-validation
+    trial accuracy of the combined output (val_eval), replacing the released selection by TARGET
+    combined correctness. Returns (best_state_dict, info, scaler_eeg, scaler_eye)."""
+    net_eeg = net_eeg.to(device).eval()
+    net_eye = net_eye.to(device).eval()
+    S_eeg_trans = aligned_features(net_eeg, S_eeg, device)
+    T_eeg_trans = aligned_features(net_eeg, T_eeg, device)
+    S_eye_trans = aligned_features(net_eye, S_eye, device)
+    T_eye_trans = aligned_features(net_eye, T_eye, device)
+
+    Train_datas, scaler_eeg, scaler_eye = preprocess_dataset(S_eeg_trans, S_eye_trans, S_label, S_idx,
+                                                             T_eeg_trans, T_eye_trans)
+    train_dataset = Dataset_seed(Train_datas)
+    # compatibility fix: seeded generator for the shuffle
+    trainData_loader = DataLoader(dataset=train_dataset, batch_size=FUSION_BATCH, shuffle=True, drop_last=True,
+                                  generator=generator)
+
+    model = EFCL_seed_final(config=config)
+    model = model.to(device)
+    arg_opt = utils.AttrDict(config['optimizer'])
+    optimizer = create_optimizer(arg_opt, model)
+    best_val, best_state, best_epoch, curve = -1.0, None, 0, []
+    for epoch in range(n_epochs):
+        running_correct, sums = Train(model, trainData_loader, optimizer, epoch, device, config)
+        val_acc = val_eval(model, scaler_eeg, scaler_eye)
+        curve.append({"epoch": epoch + 1, "train_window_acc": float(running_correct) / len(train_dataset),
+                      "loss_contrast": sums["contrast"] / sums["n"], "loss_match": sums["match"] / sums["n"],
+                      "loss_class": sums["class"] / sums["n"], "steps": sums["n"], "val_trial_acc": val_acc})
+        sys.stdout.write(f"\r[{STAGE}] epoch {epoch + 1}/{n_epochs} train {curve[-1]['train_window_acc']:.4f} val {val_acc:.4f}")
+        sys.stdout.flush()
+        if val_acc > best_val:
+            best_val, best_epoch = val_acc, epoch + 1
+            best_state = copy.deepcopy(model.state_dict())
+    sys.stdout.write("\n")
+    scalers = {"eeg": {"data_min_": scaler_eeg.data_min_.tolist(), "data_max_": scaler_eeg.data_max_.tolist()},
+               "eye": {"data_min_": scaler_eye.data_min_.tolist(), "data_max_": scaler_eye.data_max_.tolist()}}
+    return best_state, {"source_val_acc": best_val, "selected_epoch": best_epoch, "curve": curve,
+                        "total_updates": sum(c["steps"] for c in curve), "scalers": scalers,
+                        "n_train_windows": len(train_dataset),
+                        "windows_dropped_per_epoch_by_drop_last": len(train_dataset) % FUSION_BATCH}, scaler_eeg, scaler_eye
+
+
+if __name__ == '__main__':
+    raise SystemExit("protocol-adapted CSMM: run through scripts/07_comparators.py (ccsi/comparators.py)")
